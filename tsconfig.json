{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "express", "multer"]
  },
  "include": ["server.ts", "src/**/*.ts", "src/**/*.d.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
