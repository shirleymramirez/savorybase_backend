{
  "name": "savorybase-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "RESTful Food CMS API for Savorybase",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --exec tsx server.ts",
    "start": "node dist/server.js",
    "migrate:food-categories": "ts-node scripts/migrateFoodCategories.ts",
    "refresh:order-frequency-stats": "ts-node scripts/refreshOrderFrequencyStats.ts"
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "cms",
    "food-api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "multer": "^1.4.5-lts.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.30",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
